<div class="container">
    <h1>Recent Links</h1>

    <% if @links.empty? %>
        <p class="muted">No links shortened yet.</p>
    <% else %>
        <table class="link-table">
            <thead>
                <tr>
                    <th>Short URL</th>
                    <th>Original URL</th>
                </tr>
            </thead>
            <tbody>
                <% @links.each do |link| %>
                    <tr>
                        <td>
                            <a href="<%= @base_url %>/<%= link['short_code'] %>" target="_blank">
                                <%= @base_url %>/<%= link['short_code'] %>
                            </a>
                        </td>
                        <td class="long-url-cell"><%= link['long_url'] %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    <% end %>
</div>
