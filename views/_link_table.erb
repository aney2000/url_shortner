<% if @links.empty? %>
    <p class="muted"><%= empty_message %></p>
<% else %>
    <div class="table-wrap">
        <table class="link-table">
            <thead>
                <tr>
                    <th>Short URL</th>
                    <th>Original URL</th>
                </tr>
            </thead>
            <tbody>
                <% @links.each do |link| %>
                    <tr>
                        <td><a href="<%= @base_url %>/<%= link['short_code'] %>" target="_blank"><%= @base_url %>/<%= link['short_code'] %></a></td>
                        <td class="long-url-cell"><%= h link['long_url'] %></td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    </div>
<% end %>
