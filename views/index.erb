<div class="card">
    <h2>Shorten a URL</h2>
    <form action="/" method="POST" class="shorten-form">
        <input type="url" name="long_url" placeholder="Paste your long link here..." required>
        <button type="submit" class="btn-primary">Shorten</button>
    </form>

    <% if @error %>
        <p class="error"><%= h @error %></p>
    <% end %>

    <% if @short_url %>
        <div class="result">
            Success! Your short link is:
            <a href="<%= @short_url %>" target="_blank"><%= @short_url %></a>
        </div>
        <% if @url_warning %>
            <p class="warning"><%= h @url_warning %></p>
        <% end %>
    <% end %>
</div>

<div class="card">
    <h2>My Links</h2>
    <%= erb :_link_table, locals: { empty_message: 'No links yet. Shorten your first URL above!' } %>
</div>
