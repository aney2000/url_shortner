<div class="card">
    <h2>Shorten a URL</h2>
    <form action="/" method="POST" class="shorten-form">
        <input type="url" name="long_url" placeholder="Paste your long link here..." required>
        <button type="submit" class="btn-primary">Shorten</button>
    </form>

    <% if @error %>
        <p class="error"><%= @error %></p>
    <% end %>

    <% if @short_url %>
        <div class="result">
            Success! Your short link is:
            <a href="<%= @short_url %>" target="_blank"><%= @short_url %></a>
        </div>
    <% end %>
</div>

<div class="card">
    <h2>My Links</h2>
    <% if @links.empty? %>
        <p class="muted">No links yet. Shorten your first URL above!</p>
    <% else %>
        <div class="table-wrap">
            <table class="link-table">
                <thead>
                    <tr>
                        <th>Short URL</th>
                        <th>Original URL</th>
                    </tr>
                </thead>
                <tbody>
                    <% @links.each do |link| %>
                        <tr>
                            <td><a href="<%= @base_url %>/<%= link['short_code'] %>" target="_blank"><%= @base_url %>/<%= link['short_code'] %></a></td>
                            <td class="long-url-cell"><%= link['long_url'] %></td>
                        </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
    <% end %>
</div>
