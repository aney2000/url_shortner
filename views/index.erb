<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Clean URL Shortener</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="nav-bar">
        <% if @current_user %>
            <span>Hello, <strong><%= @current_user['username'] %></strong></span>
            <a href="/dashboard">My Links</a>
            <form action="/logout" method="POST" class="inline-form">
                <button type="submit" class="nav-link-btn">Logout</button>
            </form>
        <% else %>
            <a href="/login">Log In</a>
            <a href="/signup">Sign Up</a>
        <% end %>
    </nav>

    <div class="container">
        <h1>URL Shortener</h1>

        <form action="/" method="POST">
            <input type="url" name="long_url" placeholder="Paste your long link here..." required>
            <button type="submit">Shorten</button>
        </form>

        <% if @error %>
            <p class="error"><%= @error %></p>
        <% end %>

        <% if @short_url %>
            <div class="result">
                Success! Your short link is: <br>
                <a href="<%= @short_url %>" target="_blank"><%= @short_url %></a>
            </div>
        <% end %>
    </div>
</body>
</html>
