# 1. OS & Editor Files (Generated by your operating system or code editor)
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# 2. Bundler & Ruby Dependencies (We don't commit downloaded libraries)
/.bundle/
/vendor/bundle
/vendor/ruby
*.gem

# 3. Environment Variables (SECURITY: Never commit your secrets!)
.env
.env.*
!.env.example

# 4. Logs & Temp Files (Generated while the server is running)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# 5. Testing & Coverage (RSpec status and test coverage reports)
/coverage/
/spec/examples.txt
.rspec_status
